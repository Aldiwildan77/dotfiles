# Brewfile — macOS (and Linuxbrew where noted)
#
# Regenerate the raw state of a machine with:
#   brew bundle dump --force --file=packages/Brewfile.local
# then fold the diff into this curated file.
#
# Install:
#   brew bundle --file=packages/Brewfile

# ---------------------------------------------------------------------------
# Taps
# ---------------------------------------------------------------------------
tap "mutagen-io/mutagen"
tap "tinygo-org/tools"

# ---------------------------------------------------------------------------
# Shell + core userland
# ---------------------------------------------------------------------------
brew "bash"             # Bash 5 — macOS ships 3.2; SDKMAN! and modern scripts need 4+
brew "coreutils"        # GNU coreutils, so scripts behave like they do on Linux
brew "stow"             # symlink farm manager — the backbone of this repo
brew "zsh"
brew "tmux"             # config in tmux/.tmux.conf
brew "htop"
brew "ncdu"
brew "bat"              # cat with syntax highlighting
brew "ripgrep"          # rg
brew "fzf"              # fuzzy finder
brew "peco"             # interactive filter
brew "tree"
brew "watch"
brew "wget"
brew "curl"
brew "jq"
brew "yq"
brew "yazi"             # TUI file manager (see the `y` function in zsh/functions)
brew "rtk"              # CLI proxy that trims LLM token usage on dev commands
brew "gnupg"
brew "mbedtls"
brew "libxmlsec1"
brew "cjson"
brew "guile"
brew "automake"
brew "perl"

# ---------------------------------------------------------------------------
# Version control
# ---------------------------------------------------------------------------
brew "git"
brew "git-lfs"
brew "git-filter-repo"
brew "gh"               # GitHub CLI — also used as the git credential helper
brew "mercurial"

# ---------------------------------------------------------------------------
# Languages + toolchains
# ---------------------------------------------------------------------------
brew "go"
brew "tinygo-org/tools/tinygo"
brew "pyenv"
brew "ruby"             # macOS ships 2.6; gems in packages/gem.txt need >= 3
brew "pnpm"
brew "yarn"
brew "nx"

# ---------------------------------------------------------------------------
