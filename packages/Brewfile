# ---------------------------------------------------------------------------
# Infrastructure / DevOps / SysAdmin
# ---------------------------------------------------------------------------
brew "ansible"
brew "kubernetes-cli"   # kubectl
brew "helm"
brew "k9s"
brew "stern"            # multi-pod log tailing
brew "kubectx"          # kubectx + kubens
brew "colima"           # Docker runtime VM — replaces Docker Desktop (`colima start`)
brew "docker"           # docker CLI only, talks to colima
brew "docker-compose"   # `docker compose` plugin
brew "docker-buildx"    # `docker buildx` plugin
brew "awscli"
brew "flyctl"
brew "mkcert"           # local trusted TLS certs
brew "sops"             # encrypted secrets at rest
brew "age"              # sops backend
brew "mutagen-io/mutagen/mutagen"
brew "rclone"
brew "mole"             # Mac disk cleaner / optimizer (mole.fit), CLI for mole-app
brew "arp-scan"
brew "nmap"             # port and host scanning
brew "mtr"              # traceroute + ping per hop (run with sudo on macOS)
brew "iperf3"           # throughput between two hosts
brew "nload"
brew "telnet"

