# Pinned runtime versions, sourced by install/langs.sh.
# Bump a line here and re-run `./setup.sh langs` to move every machine together.

# Node — installed via nvm. First entry becomes the default.
NODE_VERSIONS="24.15.0 22.13.1"

# Python — installed via pyenv. First entry becomes the global default.
PYTHON_VERSIONS="3.13.3 3.12.3 3.11.9 3.10.17"

# Go — the Homebrew/distro `go` is the default; vfox carries the older lines
# that legacy services still build against.
GO_VERSIONS="1.22.5 1.19.1"

# Java — installed via SDKMAN! on macOS/Linux.
JAVA_VERSION="11.0.15.1-tem"

# Ruby — the system/distro ruby is used as-is; set this to install via rbenv.
RUBY_VERSION=""
